{
  "name": "frontend-mentesmejorando",
  "version": "0.0.1",
  "author": "HAWK SRL",
  "homepage": "https://mentesmejorando.com/",
  "private": true,
  "scripts": {
    "clean": "ionic-app-scripts clean",
    "build": "ionic-app-scripts build",
    "lint": "ionic-app-scripts lint",
    "ionic:build": "ionic-app-scripts build",
    "ionic:serve": "ionic-app-scripts serve",
    "graphql": "npm run graphql:introspect && npm run graphql:generate",
    "graphql:introspect": "gql-gen --schema http://localhost:8000/graphql --template graphql-codegen-introspection-template --out src/graphql/schema.json",
    "graphql:generate": "gql-gen --resolvers false --schema src/graphql/schema.json --template graphql-codegen-apollo-angular-template --out src/graphql/graphql.ts src/graphql/**/*.graphql",
    "tailwind": "./node_modules/.bin/tailwind build src/tailwind/styles.css -c src/tailwind/tailwind.js -o src/tailwind/tailwind.css"
  },
  "dependencies": {
    "@angular/animations": "6.1.9",
    "@angular/cdk": "^6.1.0",
    "@angular/common": "6.1.9",
    "@angular/compiler": "6.1.9",
    "@angular/compiler-cli": "6.1.9",
    "@angular/core": "6.1.9",
    "@angular/flex-layout": "6.0.0-beta.16",
    "@angular/forms": "6.1.9",
    "@angular/http": "6.1.9",
    "@angular/material": "^6.1.0",
    "@angular/platform-browser": "6.1.9",
    "@angular/platform-browser-dynamic": "6.1.9",
    "@auth0/angular-jwt": "^1.2.0",
    "@datorama/akita": "^1.11.0",
    "@ionic-native/core": "4.8.0",
    "@ionic-native/splash-screen": "4.8.0",
    "@ionic-native/status-bar": "4.8.0",
    "@ionic/storage": "2.1.3",
    "@material-extended/mde": "^2.0.1",
    "@ngx-translate/core": "^9.1.1",
    "@ngx-translate/http-loader": "^2.0.1",
    "@types/node": "^10.11.6",
    "angular-file": "^0.5.4",
    "apollo-angular": "^1.4.1",
    "apollo-angular-link-http": "^1.3.1",
    "apollo-cache-inmemory": "^1.3.5",
    "apollo-client": "^2.4.2",
    "apollo-link": "^1.2.3",
    "apollo-link-context": "^1.0.9",
    "apollo-link-error": "^1.1.1",
    "cordova-android": "6.3.0",
    "cordova-browser": "5.0.3",
    "cordova-plugin-device": "^2.0.2",
    "cordova-plugin-ionic-keyboard": "^2.0.5",
    "cordova-plugin-ionic-webview": "^1.1.19",
    "cordova-plugin-splashscreen": "^5.0.2",
    "cordova-plugin-whitelist": "^1.3.3",
    "date-fns": "^1.29.0",
    "graphql": "^0.13.2",
    "graphql-tag": "^2.10.0",
    "ionic-angular": "3.9.2",
    "ionicons": "3.0.0",
    "moment": "^2.22.1",
    "moment-timezone": "^0.5.17",
    "ng-animate": "^0.3.2",
    "ngx-gauge": "^1.0.0-beta.4",
    "ngx-moment": "^2.0.0",
    "ngx-take-until-destroy": "^5.2.3",
    "rxjs": "6.2.1",
    "rxjs-compat": "6.2.1",
    "safe-pipe": "^0.3.0",
    "sw-toolbox": "3.6.0",
    "tailwindcss": "^0.6.1",
    "zone.js": "0.8.26"
  },
  "devDependencies": {
    "@ionic/app-scripts": "3.1.10",
    "graphql-code-generator": "^0.12.5",
    "graphql-codegen-apollo-angular-template": "^0.12.5",
    "graphql-codegen-introspection-template": "^0.12.5",
    "graphql-codegen-typescript-template": "^0.12.5",
    "typescript": "^2.9.2"
  },
  "description": "One Car Rental fontend",
  "config": {
    "ionic_copy": "./config/copy.config.js",
    "ionic_sass": "./config/sass.config.js"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-whitelist": {},
      "cordova-plugin-device": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-ionic-webview": {},
      "cordova-plugin-ionic-keyboard": {}
    },
    "platforms": [
      "browser",
      "android"
    ]
  }
}
